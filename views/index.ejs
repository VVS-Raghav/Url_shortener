<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <h1>URL Shortener</h1>
    <div class="container">
        <form action="/shorten" method="POST" class="shorten-form">
            <label for="url">Enter URL:</label>
            <input type="text" id="url" name="url" placeholder="Enter URL" required>
            <button type="submit" class="btn">Shorten</button>
        </form>

        <%if(locals.urls){%>
            <table class="url-table">
                <thead>
                    <tr>
                        <th>Original URL</th>
                        <th>Shortened URL</th>
                        <th>Clicks</th>
                    </tr>
                </thead>

                <tbody>
                    <% urls.forEach(url=> { %>
                        <tr>
                            <td><a href="<%= url.originalUrl %>"><%= url.originalUrl %></a></td>
                            <td><a href="<%= url.shortUrl %>"><%= url.shortUrl %></a></td>
                            <td><%= url.clicks %></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        <%}%>
    </div>
</body>
</html>